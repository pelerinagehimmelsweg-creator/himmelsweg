rules_version = '2';

// Règles de sécurité de la base Himmelsweg.
// C'est ICI que se joue la protection des données (RGPD) : même si quelqu'un
// bricole l'app, la base refuse de lui envoyer ce qu'il n'a pas le droit de voir.
//
// Qui est qui :
//  - admin : connecté avec Google, adresse inscrite dans la collection « admins »
//            (un document par adresse, ex. admins/directrice@gmail.com) ;
//  - participant : connecté par son lien personnel, son identifiant = celui de sa fiche membres/{id}.

service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }

    function estAdmin() {
      return connecte()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    function moi() { return get(/databases/$(database)/documents/membres/$(request.auth.uid)).data; }
    function jeSuisMembre() { return connecte() && exists(/databases/$(database)/documents/membres/$(request.auth.uid)); }
    function aRole(r) { return jeSuisMembre() && moi().roles.hasAny([r]); }
    function monChapitre() { return moi().get('chapitre', null); }
    function memeChapitre(ch) { return ch != null && monChapitre() == ch; }

    // Liste des admins : chacun ne peut vérifier que sa propre adresse.
    match /admins/{email} {
      allow get: if connecte() && request.auth.token.email.lower() == email;
      allow list, write: if false; // géré dans la console Firebase
    }

    // Contenus avant / pendant / après : lus par tous les connectés, écrits par les admins.
    match /contenus/{id} {
      allow read: if estAdmin() || jeSuisMembre();
      allow write: if estAdmin();
    }

    match /chapitres/{id} {
      allow read: if estAdmin() || jeSuisMembre();
      allow write: if estAdmin();
    }

    // Questionnaire d'inscription et tarifs : lus par tout le monde (formulaire public),
    // modifiés par les admins. Les inscriptions elles-mêmes passent par le script Google.
    match /questions/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }
    match /config/{id} {
      // config/inscription est publique ; config/app (numéro d'alerte…) pour les connectés.
      allow read: if id == 'inscription' || estAdmin() || jeSuisMembre();
      allow write: if estAdmin();
    }

    // ----- Outils des équipes -----
    function equipe(r) { return estAdmin() || aRole(r); }

    // Repas : réglages, quantités et fournisseurs.
    match /equipes/repas {
      allow read, write: if equipe('repas');
    }
    match /fournisseurs/{id} {
      allow read, write: if equipe('repas');
    }
    // Nombre par régime (sans noms), calculé par le script Google.
    match /stats/{id} {
      allow read: if equipe('repas') || aRole('logistique');
      allow write: if false;
    }
    // Parcours : lu par la logistique, les chefs et les adjoints sécurité, écrit par la logistique.
    match /parcours/{id} {
      allow read: if equipe('logistique') || aRole('chef') || aRole('securite');
      allow write: if equipe('logistique');
    }
    match /prevoyance/{id} {
      allow read, write: if equipe('logistique');
    }
    // Un fil de discussion par équipe ; chacun signe ses messages.
    match /fils/{nom}/messages/{id} {
      function membreDuFil() { return estAdmin() || (nom != 'admins' && aRole(nom)); }
      allow read: if membreDuFil();
      allow create: if membreDuFil() && request.resource.data.auteur == request.auth.uid
        && request.resource.data.texte is string && request.resource.data.texte.size() <= 2000;
      allow delete: if estAdmin();
    }
    // Alertes accident : lancées par un adjoint sécurité, vues par la logistique.
    match /alertes/{id} {
      allow create: if aRole('securite') && request.resource.data.auteur == request.auth.uid;
      allow read: if equipe('logistique') || (connecte() && resource.data.auteur == request.auth.uid);
      allow update: if equipe('logistique') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['traitee']);
    }
    // Jeton de notification de chaque téléphone : écrit par son propriétaire, lu par le script seulement.
    match /jetons/{uid} {
      allow create, update: if connecte() && request.auth.uid == uid;
      allow read: if false;
    }

    // Dossiers d'inscription (payeur, montant, paiement) : admins seulement.
    match /dossiers/{ref} {
      allow read, write: if estAdmin();
    }

    // Fiches des pèlerins (nom, téléphone, chapitre, rôles).
    match /membres/{id} {
      allow read: if estAdmin()
        || (connecte() && request.auth.uid == id)
        || aRole('logistique')
        || ((aRole('chef') || aRole('securite')) && memeChapitre(resource.data.get('chapitre', null)));
      allow write: if estAdmin();
      // Le pèlerin corrige ses propres réponses, sans toucher à son chapitre, ses rôles ni son paiement.
      allow update: if connecte() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tel', 'email', 'reponses', 'volontaireChef']);
      // Le chef nomme ou retire l'adjoint sécurité de son chapitre : seul le rôle « securite » peut changer.
      allow update: if aRole('chef') && memeChapitre(resource.data.get('chapitre', null))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles'])
        && request.resource.data.roles.removeAll(['securite']).toSet() == resource.data.roles.removeAll(['securite']).toSet();

      // Données sensibles : santé, contact d'urgence, régime, référent des mineurs.
      match /prive/{doc} {
        allow read: if estAdmin()
          || (connecte() && request.auth.uid == id)
          || aRole('logistique')
          || (aRole('securite') && memeChapitre(get(/databases/$(database)/documents/membres/$(id)).data.get('chapitre', null)));
        allow write: if estAdmin();
        allow update: if connecte() && request.auth.uid == id && doc == 'fiche';
      }

      // Clé du lien personnel : admins seulement.
      match /admin/{doc} {
        allow read, write: if estAdmin();
      }
    }

    // Clés secrètes des liens personnels : jamais lisibles depuis un téléphone.
    // Seul le script Google (compte de service) les vérifie.
    match /liens/{cle} {
      allow create, delete: if estAdmin();
      allow read, update: if false;
    }

    match /{autre=**} {
      allow read, write: if false;
    }
  }
}
