# Copier ce fichier en .env.local pour relier l'app au vrai projet Firebase.
# Sans ces valeurs, l'app démarre en MODE DÉMO avec des pèlerins fictifs.
# Ces valeurs ne sont pas secrètes (elles finissent dans le code public de l'app) ;
# la protection des données vient des règles de sécurité (firebase/firestore.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Adresse du script Google qui transforme un lien personnel en connexion
VITE_SCRIPT_URL=
# Notifications : clé publique « Web Push » (console Firebase → Cloud Messaging → Certificats push Web)
VITE_FIREBASE_VAPID_KEY=
