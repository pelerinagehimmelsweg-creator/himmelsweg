---
import Base from '../layouts/Base.astro';
import WidgetHelloAsso from '../components/WidgetHelloAsso.astro';
import { helloasso } from '../config';
---
<Base titre="Boutique" description="La boutique du pèlerinage Himmelsweg.">
  <section class="section">
    <div class="conteneur">
      <h1 class="centre">Boutique</h1>
      <WidgetHelloAsso url={helloasso.boutique} titre="Boutique Himmelsweg" hauteur={900} />
    </div>
  </section>
</Base>
