---
import Base from '../layouts/Base.astro';
import TitrePage from '../components/TitrePage.astro';
import { Image } from 'astro:assets';
import chateau from '../assets/photos/paysage-chateau.jpg';
import banniere from '../assets/photos/banniere-vignes.jpg';
import costumes from '../assets/photos/costumes.jpg';
import odile from '../assets/photos/sainte-odile.jpg';
import { pelerinage } from '../config';
---
<Base titre="Le pèlerinage" description="L'histoire du pèlerinage Himmelsweg, né en 2025 entre Scherwiller et Colmar.">
  <TitrePage titre="Le pèlerinage" image={chateau} />

  <section class="section section-blanche">
    <div class="conteneur deux-colonnes">
      <Image src={banniere} alt="La bannière Himmelsweg au-dessus des vignes" widths={[500, 900]} sizes="(max-width: 800px) 100vw, 50vw" class="photo" />
      <div>
        <p class="surtitre">2025</p>
        <h2>Les débuts</h2>
        <p>Né en 2025 entre Scherwiller et Colmar, Himmelsweg a rassemblé une cinquantaine de participantes pour sa première édition.</p>
        <p class="surtitre" style="margin-top:2rem">2026</p>
        <h2>Née de la Lumière, avec sainte Odile</h2>
        <p>Les 8, 9 et 10 mai 2026, la deuxième édition a été placée sous la protection de sainte Odile, patronne de l'Alsace, dont les reliques ont accompagné les pèlerines tout au long du chemin.</p>
        <p><a href="/sainte-odile/">Découvrir sainte Odile</a></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="conteneur deux-colonnes">
      <div>
        <p class="surtitre">{pelerinage.annee}</p>
        <h2>La {pelerinage.edition} édition</h2>
        <p>Rendez-vous {pelerinage.datesLongues} pour trois jours de marche, de prière et de fraternité sur les chemins d'Alsace.</p>
        <div class="boutons">
          <a class="bouton" href="/inscription/">S'inscrire</a>
          <a class="bouton bouton-contour" href="/programme/">Voir le programme</a>
        </div>
      </div>
      <div class="duo">
        <Image src={costumes} alt="Pèlerines en costume alsacien" widths={[400, 700]} sizes="(max-width: 800px) 50vw, 25vw" class="photo" />
        <Image src={odile} alt="Icône de sainte Odile" widths={[400, 640]} sizes="(max-width: 800px) 50vw, 25vw" class="photo" />
      </div>
    </div>
  </section>
</Base>
<style>
  .duo { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .duo :global(img) { aspect-ratio: 2 / 3; }
</style>
