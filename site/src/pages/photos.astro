---
// Galerie de photos de Lucie Claisse (consultation seule) : grille, puis grande vue avec précédente / suivante.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import TitrePage from '../components/TitrePage.astro';

const PHOTOGRAPHE = { nom: 'Lucie Claisse', site: 'https://lucieclaissephotographies.pixieset.com/' };

const fichiers = import.meta.glob<{ default: ImageMetadata }>('../assets/galerie/*.jpg', { eager: true });
const photos = await Promise.all(
  Object.keys(fichiers)
    .sort()
    .map(async (cle) => {
      const src = fichiers[cle].default;
      const grand = await getImage({ src, width: Math.min(1400, src.width), format: 'webp' });
      return { src, grand: grand.src };
    }),
);
const banniere = photos[7]?.src ?? photos[0].src;
---
<Base titre="Photos" description="Le pèlerinage Himmelsweg en images, par la photographe Lucie Claisse.">
  <TitrePage titre="En images" image={banniere} position="center 60%" />

  <section class="section">
    <div class="conteneur">
      <p class="galerie-intro">
        Les vignes, les costumes, la bannière du pèlerinage : quelques images du Chemin du Ciel.
      </p>
      <p class="galerie-credit">
        Photos © <a href={PHOTOGRAPHE.site} target="_blank" rel="noopener">{PHOTOGRAPHE.nom}</a>
      </p>

      <ul class="galerie" oncontextmenu="return false">
        {photos.map((p, k) => (
          <li>
            <button type="button" class="galerie-vignette" data-k={k} data-grand={p.grand} aria-label={`Agrandir la photo ${k + 1} sur ${photos.length}`}>
              <Image src={p.src} alt="" widths={[400, 700]} sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 25vw" draggable="false" />
            </button>
          </li>
        ))}
      </ul>

      <p class="galerie-credit bas">
        Toutes les photos de cette page sont de <a href={PHOTOGRAPHE.site} target="_blank" rel="noopener">{PHOTOGRAPHE.nom}</a>. Merci de ne pas les réutiliser sans son accord.
      </p>
    </div>
  </section>

  <dialog class="visionneuse" aria-label="Photo agrandie" oncontextmenu="return false">
    <img alt="" draggable="false" />
    <button type="button" class="v-fermer" aria-label="Fermer">×</button>
    <button type="button" class="v-prec" aria-label="Photo précédente">‹</button>
    <button type="button" class="v-suiv" aria-label="Photo suivante">›</button>
    <p class="v-legende"><span class="v-num"></span> · Photo © {PHOTOGRAPHE.nom}</p>
  </dialog>
</Base>

<script>
  const vignettes = [...document.querySelectorAll<HTMLButtonElement>('.galerie-vignette')];
  const dlg = document.querySelector<HTMLDialogElement>('.visionneuse')!;
  const img = dlg.querySelector('img')!;
  const num = dlg.querySelector('.v-num')!;
  let k = 0;
  const montrer = (n: number) => {
    k = (n + vignettes.length) % vignettes.length;
    img.src = vignettes[k].dataset.grand!;
    num.textContent = `${k + 1} / ${vignettes.length}`;
    // Précharge la suivante.
    new Image().src = vignettes[(k + 1) % vignettes.length].dataset.grand!;
  };
  vignettes.forEach((v, n) =>
    v.addEventListener('click', () => {
      montrer(n);
      dlg.showModal();
    }),
  );
  dlg.querySelector('.v-fermer')!.addEventListener('click', () => dlg.close());
  dlg.querySelector('.v-prec')!.addEventListener('click', () => montrer(k - 1));
  dlg.querySelector('.v-suiv')!.addEventListener('click', () => montrer(k + 1));
  dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
  dlg.addEventListener('close', () => vignettes[k]?.focus());
  addEventListener('keydown', (e) => {
    if (!dlg.open) return;
    if (e.key === 'ArrowLeft') montrer(k - 1);
    if (e.key === 'ArrowRight') montrer(k + 1);
  });
  // Glisser du doigt pour passer d'une photo à l'autre.
  let x0: number | null = null;
  dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  dlg.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) montrer(k + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>

<style>
  .galerie-intro { text-align: center; max-width: 40rem; margin: 0 auto .4rem; font-size: 1.1rem; }
  .galerie-credit { text-align: center; color: #6b6158; font-size: .95rem; margin: 0 0 2rem; }
  .galerie-credit a { font-weight: 600; }
  .galerie-credit.bas { margin: 2.5rem auto 0; max-width: 36rem; }
  .galerie { list-style: none; padding: 0; margin: 0; columns: 4 220px; column-gap: .7rem; }
  .galerie li { break-inside: avoid; margin-bottom: .7rem; }
  .galerie-vignette { display: block; width: 100%; padding: 0; border: 0; background: var(--creme-fonce); border-radius: 6px; overflow: hidden; cursor: zoom-in; }
  .galerie-vignette img { display: block; width: 100%; height: auto; transition: transform .5s ease, opacity .3s; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
  .galerie-vignette:hover img { transform: scale(1.03); }
  .galerie-vignette:focus-visible { outline: 3px solid var(--rouge); outline-offset: 2px; }
  @media (max-width: 600px) { .galerie { columns: 2; column-gap: .45rem; } .galerie li { margin-bottom: .45rem; } }

  .visionneuse { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: rgba(20, 16, 14, .94); color: #f6f1e4; }
  .visionneuse::backdrop { background: rgba(20, 16, 14, .94); }
  .visionneuse[open] { display: flex; align-items: center; justify-content: center; }
  .visionneuse img { max-width: calc(100vw - 2rem); max-height: calc(100dvh - 5.5rem); object-fit: contain; border-radius: 4px; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none; }
  .visionneuse button { position: absolute; border: 0; background: rgba(255, 253, 248, .12); color: #fff; font-size: 2.2rem; line-height: 1; width: 3rem; height: 3rem; border-radius: 50%; cursor: pointer; }
  .visionneuse button:hover { background: var(--rouge); }
  .v-fermer { top: 1rem; right: 1rem; }
  .v-prec { left: 1rem; top: 50%; transform: translateY(-50%); }
  .v-suiv { right: 1rem; top: 50%; transform: translateY(-50%); }
  .v-legende { position: absolute; bottom: .8rem; left: 0; right: 0; text-align: center; margin: 0; font-size: .9rem; opacity: .8; pointer-events: none; }
  @media (max-width: 600px) { .v-prec, .v-suiv { top: auto; bottom: .6rem; transform: none; } .v-legende { bottom: 1.4rem; } }
</style>
