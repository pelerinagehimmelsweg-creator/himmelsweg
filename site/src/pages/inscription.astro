---
import Base from '../layouts/Base.astro';
import WidgetHelloAsso from '../components/WidgetHelloAsso.astro';
import { helloasso, pelerinage, contact } from '../config';
---
<Base titre="Inscription" description={`Inscription au pèlerinage Himmelsweg, ${pelerinage.dates}. Inscription uniquement en ligne, places limitées.`}>
  <section class="section">
    <div class="conteneur">
      <div class="etroit centre">
        <p class="surtitre">{pelerinage.dates}</p>
        <h1>Inscription</h1>
        <p>L'inscription se fait uniquement en ligne et le nombre de places est limité. Le paiement est sécurisé par HelloAsso.</p>
        <p>Les femmes et les hommes s'inscrivent séparément : choisissez votre formulaire ci-dessous.</p>
        <div class="boutons" style="justify-content:center">
          <a class="bouton" href="#femmes">Pèlerines (femmes)</a>
          <a class="bouton" href="#hommes">Pèlerins (hommes)</a>
        </div>
      </div>

      <div class="inscriptions">
        <div id="femmes">
          <h2>Pèlerines</h2>
          <WidgetHelloAsso url={helloasso.inscriptionFemmes} titre="Inscription des pèlerines" />
        </div>
        <div id="hommes">
          <h2>Pèlerins</h2>
          <WidgetHelloAsso url={helloasso.inscriptionHommes} titre="Inscription des pèlerins" />
        </div>
      </div>

      <div class="etroit centre" style="margin-top:2rem">
        <p>Une question avant de vous inscrire ? Consultez les <a href="/informations-pratiques/">informations pratiques</a> ou écrivez à <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .inscriptions { display: grid; gap: 2.5rem; margin-top: 2.5rem; }
  .inscriptions > div { scroll-margin-top: 100px; }
</style>
