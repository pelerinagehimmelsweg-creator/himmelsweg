---
import Base from '../layouts/Base.astro';
import TitrePage from '../components/TitrePage.astro';
import FormulaireContact from '../components/FormulaireContact.astro';
import photo from '../assets/photos/vignes-automne.jpg';
import { contact } from '../config';
---
<Base titre="Contact" description="Contacter le secrétariat du pèlerinage Himmelsweg.">
  <TitrePage titre="Contact" image={photo} />
  <section class="section">
    <div class="conteneur deux-colonnes" style="align-items:start">
      <div class="carte"><FormulaireContact sujet="Contact" /></div>
      <div>
        <h2>Pèlerinage Himmelsweg</h2>
        <p>{contact.adresse.slice(1).map((l) => <>{l}<br /></>)}</p>
        <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        <p><a href={contact.instagram} rel="noopener">Suivez-nous sur Instagram</a></p>
      </div>
    </div>
  </section>
</Base>
