---
// Petit carrousel de photos de la communication (séance de Lucie Claisse) : glisser au doigt,
// ou flèches et points. Défilement doux toutes les 5 secondes, arrêté dès que l'on y touche.
import { Image } from 'astro:assets';

interface Photo { src: ImageMetadata; alt: string; position?: string }
const { photos } = Astro.props as { photos: Photo[] };
---
<figure class="carrousel" aria-roledescription="carrousel" aria-label="Photos du pèlerinage">
  <div class="car-piste" tabindex="0">
    {photos.map((p, k) => (
      <div class="car-diapo" aria-label={`${k + 1} sur ${photos.length}`}>
        <Image src={p.src} alt={p.alt} widths={[480, 800]} sizes="(max-width: 800px) 92vw, 680px" style={p.position ? `object-position:${p.position}` : undefined} loading={k ? 'lazy' : 'eager'} />
      </div>
    ))}
  </div>
  <button type="button" class="car-fleche car-prec" aria-label="Photo précédente">‹</button>
  <button type="button" class="car-fleche car-suiv" aria-label="Photo suivante">›</button>
  <div class="car-points">
    {photos.map((_, k) => <button type="button" aria-label={`Photo ${k + 1}`} data-k={k}></button>)}
  </div>
  <figcaption>Photos © <a href="https://lucieclaissephotographies.pixieset.com/" target="_blank" rel="noopener">Lucie Claisse</a></figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.carrousel').forEach((car) => {
    const piste = car.querySelector<HTMLElement>('.car-piste')!;
    const points = [...car.querySelectorAll<HTMLButtonElement>('.car-points button')];
    const n = points.length;
    const actuelle = () => Math.round(piste.scrollLeft / piste.clientWidth);
    const aller = (k: number) => piste.scrollTo({ left: ((k + n) % n) * piste.clientWidth, behavior: 'smooth' });
    const maj = () => points.forEach((p, k) => p.setAttribute('aria-current', String(k === actuelle())));
    piste.addEventListener('scroll', () => requestAnimationFrame(maj), { passive: true });
    maj();
    let minuterie = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : window.setInterval(() => aller(actuelle() + 1), 5000);
    const arreter = () => { clearInterval(minuterie); minuterie = 0; };
    ['pointerdown', 'wheel', 'keydown', 'focusin'].forEach((e) => car.addEventListener(e, arreter, { passive: true }));
    car.querySelector('.car-prec')!.addEventListener('click', () => aller(actuelle() - 1));
    car.querySelector('.car-suiv')!.addEventListener('click', () => aller(actuelle() + 1));
    points.forEach((p, k) => p.addEventListener('click', () => aller(k)));
  });
</script>

<style>
  .carrousel { position: relative; margin: 1.8rem 0; }
  .car-piste { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 8px; }
  .car-piste::-webkit-scrollbar { display: none; }
  .car-diapo { flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 3 / 2; }
  .car-diapo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .car-fleche { position: absolute; top: calc(50% - 1.6rem); width: 2.4rem; height: 2.4rem; border: 0; border-radius: 50%; background: rgba(255, 253, 248, .85); color: var(--rouge); font-size: 1.6rem; line-height: 1; cursor: pointer; display: grid; place-items: center; padding: 0 0 .15rem; }
  .car-prec { left: .6rem; }
  .car-suiv { right: .6rem; }
  .car-points { display: flex; justify-content: center; gap: .45rem; margin-top: .7rem; }
  .car-points button { width: .55rem; height: .55rem; padding: 0; border: 0; border-radius: 50%; background: var(--creme-fonce); cursor: pointer; }
  .car-points button[aria-current='true'] { background: var(--rouge); }
  .carrousel figcaption { text-align: center; font-size: .85rem; color: #6b6158; margin-top: .4rem; }
  @media (hover: none) { .car-fleche { display: none; } }
</style>
