---
// Carte de l'Alsace et chemin du pèlerinage, dessinés quand la carte arrive à l'écran.
// mode « accueil » : l'Alsace se dessine, puis on se rapproche du chemin qui se trace en rouge.
// mode « programme » : déjà rapprochée ; la journée qu'on lit s'allume (voir [slug].astro).
import { carteChemin, LARGEUR, HAUTEUR } from '../lib/chemin';

interface Props {
  mode?: 'accueil' | 'programme';
  dates?: string[];
}
const { mode = 'accueil', dates = ['Vendredi 7 mai', 'Samedi 8 mai', 'Dimanche 9 mai'] } = Astro.props;
const c = carteChemin();
const sousTitres = [...dates.slice(0, 3), 'Arrivée'];
---
<svg class={`carte-chemin mode-${mode}`} viewBox={`0 0 ${LARGEUR} ${HAUTEUR}`} role="img" aria-label="Carte de l'Alsace : le chemin de Scherwiller à Colmar par Ribeauvillé et Turckheim, en trois jours.">
  <g class="cc-zoom" style={mode === 'programme' ? `transform: ${c.transform}` : `--zoom: ${c.transform}`}>
    <path class="cc-alsace" d={c.contour} pathLength="1" />
    <path class="cc-trace" d={c.trace} pathLength="1" />
    {c.jours.map((d, k) => <path class="cc-jour" data-jour={k} d={d} />)}
  </g>
  {mode === 'accueil' && (
    <g class="cc-reperes">
      {c.reperes.map((r) => (
        <g>
          <circle cx={r.xy[0]} cy={r.xy[1]} r="2.4" />
          <text x={r.xy[0] + 6} y={r.xy[1] + 3.5}>{r.nom}</text>
        </g>
      ))}
    </g>
  )}
  {c.etapes.map((e, k) => {
    const [x, y] = e.xy;
    const arrivee = k === c.etapes.length - 1;
    const gauche = x < LARGEUR / 2 - 10;
    const xt = gauche ? x - 10 : x + 10;
    return (
      <g class={`cc-etape${arrivee ? ' arrivee' : ''}`} data-etape={k} style={`--part: ${e.part.toFixed(3)}`}>
        <circle cx={x} cy={y} r={arrivee ? 5.5 : 4} />
        {arrivee && <path class="cc-croix" d={`M${x} ${y - 10} v-15 M${x - 5} ${y - 20} h10`} />}
        <text x={xt} y={y - 1} text-anchor={gauche ? 'end' : 'start'}>{e.nom}</text>
        <text class="cc-date" x={xt} y={y + 12} text-anchor={gauche ? 'end' : 'start'}>{sousTitres[k]}</text>
      </g>
    );
  })}
</svg>

<script>
  // Lance l'animation quand la carte arrive à l'écran (une seule fois).
  const cartes = document.querySelectorAll<SVGElement>('.carte-chemin');
  if (!('IntersectionObserver' in window)) cartes.forEach((c) => c.classList.add('visible', 'zoome'));
  else {
    const io = new IntersectionObserver(
      (entrees) =>
        entrees.forEach((e) => {
          if (!e.isIntersecting) return;
          const c = e.target as SVGElement;
          c.classList.add('visible');
          io.unobserve(c);
          if (c.classList.contains('mode-accueil')) {
            const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
            setTimeout(() => c.classList.add('zoome'), calme ? 0 : 1700);
          }
        }),
      { threshold: 0.35 },
    );
    cartes.forEach((c) => io.observe(c));
  }
</script>

<style>
  .carte-chemin { display: block; width: 100%; height: auto; max-height: 72vh; overflow: hidden; }
  .cc-zoom { transform-origin: 0 0; transition: transform 1.3s cubic-bezier(.6, 0, .25, 1); }
  .mode-accueil.zoome .cc-zoom { transform: var(--zoom); }
  .mode-accueil.zoome, .mode-programme { -webkit-mask-image: radial-gradient(closest-side, #000 74%, transparent); mask-image: radial-gradient(closest-side, #000 74%, transparent); }
  .cc-alsace { fill: var(--blanc); fill-opacity: 0; stroke: #b9ad97; stroke-width: .8; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .cc-trace { fill: none; stroke: var(--rouge); stroke-width: 1.45; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .cc-jour { fill: none; stroke: transparent; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; transition: stroke .4s; }
  .cc-reperes { opacity: 0; transition: opacity .5s; }
  .cc-reperes circle, .cc-reperes text { fill: #8f8574; }
  .cc-reperes text { font: 600 10px var(--texte); }
  .cc-etape { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .cc-etape circle { fill: var(--blanc); stroke: var(--rouge); stroke-width: 2; }
  .cc-etape.arrivee circle { fill: var(--rouge); }
  .cc-croix { stroke: var(--rouge); stroke-width: 2.2; stroke-linecap: round; }
  .cc-etape text { fill: var(--encre); font: 700 11.5px var(--texte); paint-order: stroke; stroke: var(--blanc); stroke-width: 3px; }
  .cc-etape text.cc-date { fill: var(--rouge); font-weight: 600; font-size: 9.5px; }

  /* Accueil : contour (0 s), repères (0,8 s), rapprochement (1,7 s), chemin (3 s), étapes au passage du chemin. */
  .visible .cc-alsace { animation: cc-contour 1.4s ease-in-out forwards, cc-remplit .8s 1.1s forwards; }
  .mode-accueil.visible .cc-reperes { opacity: 1; transition-delay: .8s; }
  .mode-accueil.zoome .cc-reperes { opacity: 0; transition-delay: 0s; }
  .mode-accueil.visible .cc-trace { animation: cc-trace 1.8s 3s cubic-bezier(.45, .05, .4, 1) forwards; }
  .mode-accueil.visible .cc-etape { animation: cc-etape .55s calc(3s + var(--part) * 1.8s) forwards; }
  /* Programme : tout se dessine plus vite, puis la journée lue s'allume. */
  .mode-programme.visible .cc-trace { animation: cc-trace 1.6s .3s cubic-bezier(.45, .05, .4, 1) forwards; }
  .mode-programme.visible .cc-etape { animation: cc-etape .55s calc(.3s + var(--part) * 1.6s) forwards; }
  .mode-programme .cc-alsace { fill-opacity: 1; }
  .mode-programme .cc-trace { stroke: rgba(179, 45, 36, .3); }
  .mode-programme[data-jour='0'] .cc-jour[data-jour='0'],
  .mode-programme[data-jour='1'] .cc-jour[data-jour='1'],
  .mode-programme[data-jour='2'] .cc-jour[data-jour='2'] { stroke: var(--rouge); }

  @keyframes cc-contour { to { stroke-dashoffset: 0; } }
  @keyframes cc-remplit { to { fill-opacity: 1; } }
  @keyframes cc-trace { to { stroke-dashoffset: 0; } }
  @keyframes cc-etape { 0% { opacity: 0; transform: scale(.4); } 70% { opacity: 1; transform: scale(1.15); } 100% { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .carte-chemin *, .carte-chemin { animation-duration: .01s !important; animation-delay: 0s !important; transition: none !important; }
  }
</style>
